    "# ==========================================\n",
    "#  ANÁLISE EXPLORATÓRIA (PERGUNTA 1)\n",
    "# ==========================================\n",
    "\n",
    "# Pergunta 1: Qual é a relação entre o grau de risco (loan_grade) e a taxa média de juros (loan_int_rate)?\n",
    "\n",
    "# Agrupando os dados por grau de risco e calculando a taxa média de juros\n",
    "analise_grade = df_clean.groupby('loan_grade')['loan_int_rate'].agg(['mean', 'median', 'min', 'max', 'count']).reset_index()\n",
    "analise_grade.columns = ['Grau de Risco', 'Taxa Média (%)', 'Taxa Mediana (%)', 'Mínima (%)', 'Máxima (%)', 'Qtd Operações']\n",
    "\n",
    "print(\"--- TABELA RESUMO: TAXA DE JUROS POR GRAU DE RISCO ---\")\n",
    "display(analise_grade)\n",
    "\n",
    "# Gerando o Gráfico\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.barplot(data=analise_grade, x='Grau de Risco', y='Taxa Média (%)', palette='Blues_r', order=sorted(df_clean['loan_grade'].unique()))\n",
    "plt.title('Taxa Média de Juros por Grau de Risco de Crédito (Loan Grade)', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Grau de Risco (Grade)', fontsize=12)\n",
    "plt.ylabel('Taxa Média de Juros (%)', fontsize=12)\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
