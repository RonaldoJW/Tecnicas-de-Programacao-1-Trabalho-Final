    "# ==========================================\n",
    "#   ANÁLISE EXPLORATÓRIA (PERGUNTA 3)\n",
    "# ==========================================\n",
    "\n",
    "# Traduzindo as categorias de moradia para o português\n",
    "traducao_moradia = {\n",
    "    'RENT': 'Aluguel',\n",
    "    'MORTGAGE': 'Financiamento',\n",
    "    'OWN': 'Própria',\n",
    "    'OTHER': 'Outros'\n",
    "}\n",
    "\n",
    "df_clean['moradia_pt'] = df_clean['person_home_ownership'].map(traducao_moradia)\n",
    "\n",
    "# Agrupando por situação de moradia\n",
    "analise_moradia = df_clean.groupby('moradia_pt').agg(\n",
    "    Comprometimento_Renda_Medio=('loan_percent_income', 'mean'),\n",
    "    Taxa_Inadimplencia=('loan_status', 'mean'),\n",
    "    Qtd_Operacoes=('loan_status', 'count')\n",
    ").reset_index()\n",
    "\n",
    "# Transformando a taxa de inadimplência e o comprometimento em percentual\n",
    "analise_moradia['Comprometimento_Renda_Medio (%)'] = (analise_moradia['Comprometimento_Renda_Medio'] * 100).round(2)\n",
    "analise_moradia['Taxa_Inadimplencia (%)'] = (analise_moradia['Taxa_Inadimplencia'] * 100).round(2)\n",
    "analise_moradia = analise_moradia.sort_values(by='Taxa_Inadimplencia (%)', ascending=False)\n",
    "\n",
    "print(\"--- TABELA RESUMO: MORADIA VS INADIMPLÊNCIA E COMPROMETIMENTO ---\")\n",
    "display(analise_moradia[['moradia_pt', 'Qtd_Operacoes', 'Comprometimento_Renda_Medio (%)', 'Taxa_Inadimplencia (%)']])\n",
    "\n",
    "# Gerando o Gráfico da Taxa de Inadimplência por Tipo de Moradia\n",
