   "source": [
    "# ==========================================\n",
    "#  ANÁLISE EXPLORATÓRIA (PERGUNTA 2 )\n",
    "# ==========================================\n",
    "\n",
    "import matplotlib.ticker as ticker\n",
    "\n",
    "# Taxa de câmbio de conversão de USD para BRL \n",
    "TAXA_CAMBIO = 5.0\n",
    "\n",
    "# Dicionário de tradução das finalidades para o português\n",
    "traducao_intent = {\n",
    "    'EDUCATION': 'Educação',\n",
    "    'MEDICAL': 'Saúde / Médico',\n",
    "    'VENTURE': 'Negócios',\n",
    "    'PERSONAL': 'Pessoal',\n",
    "    'HOMEIMPROVEMENT': 'Reforma Residencial',\n",
    "    'DEBTCONSOLIDATION': 'Consolidação de Dívidas'\n",
    "}\n",
    "\n",
    "# Aplicando a tradução\n",
    "df_clean['finalidade_pt'] = df_clean['loan_intent'].map(traducao_intent)\n",
    "\n",
    "# Agrupando e convertendo os valores de empréstimo para Reais (BRL) multiplicando pela taxa de câmbio\n",
    "analise_intent = df_clean.groupby('finalidade_pt').agg(\n",
    "    Total_Emprestado_BRL=('loan_amnt', lambda x: x.sum() * TAXA_CAMBIO),\n",
    "    Media_Emprestado_BRL=('loan_amnt', lambda x: x.mean() * TAXA_CAMBIO),\n",
    "    Taxa_Inadimplencia=('loan_status', 'mean'),\n",
    "    Qtd_Operacoes=('loan_status', 'count')\n",
    ").reset_index()\n",
    "\n",
    "# Transformando a taxa de inadimplência em percentual\n",
    "analise_intent['Taxa_Inadimplencia (%)'] = (analise_intent['Taxa_Inadimplencia'] * 100).round(2)\n",
    "analise_intent = analise_intent.sort_values(by='Total_Emprestado_BRL', ascending=False)\n",
    "\n",
    "print(\"--- TABELA RESUMO: FINALIDADE DO EMPRÉSTIMO VS INADIMPLÊNCIA (EM REAIS) ---\")\n",
    "display(analise_intent)\n",
    "\n",
    "# Gerando o Gráfico com valores em Reais (R$) e legendas em português\n",
    "plt.figure(figsize=(12, 6))\n",
    "ax = sns.barplot(data=analise_intent, x='finalidade_pt', y='Total_Emprestado_BRL', palette='viridis')\n",
    "\n",
    "plt.title('Volume Total de Capital Investido por Finalidade do Empréstimo (Em Reais - BRL)', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Finalidade do Empréstimo', fontsize=12)\n",
    "plt.ylabel('Volume Total Emprestado (R$)', fontsize=12)\n",
    "plt.xticks(rotation=25, ha='right')\n",
    "\n",
    "# Formatando o eixo Y com o símbolo de Real (R$) e separadores de milhar\n",
    "ax.yaxis.set_major_formatter(ticker.FuncFormatter(lambda x, p: f'R$ {x:,.0f}'))\n",
    "\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
